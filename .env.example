ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PORT=3100

# Optional. Overrides the speech-to-text model (default whisper-1).
# TRANSCRIBE_MODEL=gpt-4o-transcribe

# Supabase. Both of these are safe to share: the project runs with RLS off and
# there is no secret key anywhere. See supabase/04_open_access.sql.
SUPABASE_URL=
SUPABASE_KEY=

# Optional voice overrides. Defaults: gpt-4o-mini-tts / shimmer.
# TTS_MODEL=
# TTS_VOICE=
# TTS_INSTRUCTIONS=
